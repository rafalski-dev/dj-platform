
generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  User
  Admin
}

enum ClientType {
	Business
	Individual
}

enum EventType {
  Wedding
  Prom
  Anniversary
  Birthday_18
  Conference
  Corporate_Event
  Festival
  Other
}

enum EventStatus {
  Pending
  Active
  Completed
  Cancelled
  Archived
}

enum Gender {
  Female
  Male
  Other
}

enum Package {
  Classic
  Premium
  Signature
}

enum Addon {
  PhotoBooth
  StageSparks
  LiveVocalist
  Saxophonist
  LoveSign
  LowFog
  Confetti
  ExtraDj
  CustomNeon
}

enum WeddingKind {
  Church
  Civil
  Outdoor
  None
}

enum SongType {
    MustPlay
    DoNotPlay
    HighlightedMoment
}

enum SongMoment {
    Welcoming
    FirstDance
    CakePresentation
    ParentsDedication
}

enum ContractStatus {
    Draft
    Sent
    Signed
    Accepted
    Cancelled
}

enum PlaylistStatus {
    Open
    Locked
}

enum InquiryStatus {
    New
    Accepted
    Rejected
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String
  emailVerified     Boolean   @default(false)
  image             String?
  role              Role      @default(User)
  
  businessDetails   BusinessDetails?
  client            Client?
  sessions          Session[]
  accounts          Account[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model BusinessDetails {
  id                   String      @id @default(cuid())
  businessName         String?
  firstName            String
  lastName             String

  phone                String?
  email                String

  streetAndNumber      String?
  postcode             String?
  city                 String?
  region               String?
  country              String?

  userId               String       @unique
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  @@map("business_details")
}

model Client {
  id                   String       @id @default(cuid())
  clientType           ClientType
  name                 String       

  // private client
  firstName            String
  lastName             String
  gender               Gender?
  idCardNumber         String?

  // business client
  businessName         String?
  taxId                String?      @unique
  email                String?      @unique
  phone                String?

  // address
  streetAndNumber      String?
  postcode             String?
  city                 String?
  region               String?
  country              String?

  userId               String?      @unique
  user                 User?        @relation(fields: [userId], references: [id])

  notes                ClientNote[]

  events               Event[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("client")
}

model Event {
  id                   String       @id @default(cuid())
  name                 String
  type                 EventType
  altType              String?
  status               EventStatus  @default(Pending)

  date                 DateTime     @db.Date
  // hours, address and package can be missing – an accepted inquiry is filled in later
  startsAt             DateTime?
  endsAt               DateTime?

  place                String
  address              String?

  guestCount           Int?
  message              String?

  package              Package?
  addons               Addon[]
  

  clientId             String
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  contract             Contract?
  playlist             Playlist?
  wedding              WeddingDetails?
  inquiry              Inquiry?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([clientId])
  @@index([date])
  @@map("event")
}

model WeddingDetails {
  id                   String       @id @default(cuid())

  eventId              String       @unique
  event                Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  bride                String
  groom                String
  brideWitness         String
  groomWitness         String
  brideMother          String?
  brideFather          String?
  groomMother          String?
  groomFather          String?

  weddingKind          WeddingKind
  ceremonyStartsAt     DateTime?
  ceremonyPlace        String?
  ceremonyAddress      String?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("wedding_details")
}

model Contract {
  id                   String       @id @default(cuid())
  number               Int          @unique @default(autoincrement())       
  contractNumber       String?      @unique
  status               ContractStatus @default(Draft)

  eventId              String       @unique
  event                Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  fileKey              String?
  sentAt               DateTime?

  @@map("contract")
}

model Playlist {
  id                   String           @id @default(cuid())
  songs                Song[]
  status               PlaylistStatus   @default(Open)
  note                 String?

  eventId              String           @unique
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("playlist")
}

model Song {
  id                   String       @id @default(cuid())
  artist               String?
  title                String
  type                 SongType
  moment               SongMoment?
  deezerId             String?
  thumbnailURL         String?
  youtubeURL           String?

  playlistId           String       
  playlist             Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("song")
}

model ClientNote {
  id            String      @id @default(cuid())
  content       String      

  clientId      String      
  client        Client      @relation( fields:[clientId] , references:[id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()

  @@map("client_note")
}
model Inquiry {
  id                   String         @id @default(cuid())
  status               InquiryStatus  @default(New)

  firstName            String
  lastName             String
  email                String
  phone                String

  date                 DateTime       @db.Date
  type                 EventType
  place                String
  message              String?

  termsAcceptedAt      DateTime
  // language of the form – emails to the client use it
  locale               String         @default("pl")

  // set on accept – the event created from this inquiry
  eventId              String?        @unique
  event                Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([date])
  @@index([status])
  @@map("inquiry")
}

// One row per action + IP – a fixed-window counter (see src/lib/rateLimit.ts)
model RateLimit {
  key                  String         @id
  count                Int
  windowStart          DateTime

  @@map("rate_limit")
}
